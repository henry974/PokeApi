{
  "openapi": "3.0.0",
  "info": {
    "version": "1.0.0",
    "title": "Express Sample API",
    "description": "API de exemplo desenvolvida para a disciplina Tópicos Especiais em Engenharia de Software (UFF)"
  },
  "servers": [
    {
      "url": "http://localhost:3333/"
    }
  ],
  "tags": [
    {
      "name": "Pokemons",
      "description": "Endpoints de gerenciamento de Pokemons"
    },
    {
      "name": "Trainers",
      "description": "Endpoints de gerenciamento de Treinadores"
    }
  ],
  "paths": {
    "/api/v1/trainers/": {
      "get": {
        "tags": [
          "Trainers"
        ],
        "summary": "Lista todos os treinadores",
        "description": "Retorna a lista completa de treinadores cadastrados.",
        "responses": {
          "200": {
            "description": "Lista de treinadores retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Trainer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Trainers"
        ],
        "summary": "Cria um novo treinador",
        "description": "",
        "responses": {
          "201": {
            "description": "Treinador criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Treinador criado com sucesso"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos (nome, cidade ou e-mail)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Já existe um treinador com este e-mail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createTrainerDTO"
              }
            }
          }
        }
      }
    },
    "/api/v1/trainers/{email}": {
      "get": {
        "tags": [
          "Trainers"
        ],
        "summary": "Busca um treinador pelo e-mail",
        "description": "",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "E-mail do treinador",
            "example": "ash@exemplo.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Treinador encontrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Trainers"
        ],
        "summary": "Atualiza um treinador existente",
        "description": "Localiza o treinador pelo e-mail da URL. Os campos enviados no corpo substituem os atuais; se o corpo trouxer um e-mail novo, o e-mail do treinador é alterado.",
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "E-mail atual do treinador a ser atualizado",
            "example": "ash@exemplo.com"
          }
        ],
        "responses": {
          "200": {
            "description": "Treinador atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Treinador atualizado"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Trainer"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Dados inválidos",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Treinador não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "O novo e-mail já pertence a outro treinador",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/updateTrainerDTO"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Lista todos os Pokémons",
        "description": "Retorna a lista completa de Pokémons ou filtrada por tipo.",
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "description": "Filtrar por tipo de Pokémon (ex: fire, water)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de Pokémons retornada com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pokemon"
                      }
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Pokemon"
                      }
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Cria um novo Pokémon",
        "description": "",
        "responses": {
          "201": {
            "description": "Pokémon criado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokemon Criado com Sucesso"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokemon Criado com Sucesso"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/createPokemonDTO"
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}": {
      "get": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Busca um Pokémon pelo ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon encontrado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza um Pokémon existente",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon a ser atualizado"
          }
        ],
        "responses": {
          "200": {
            "description": "Pokémon atualizado com sucesso",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokemon atualizado"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              },
              "application/xml": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Pokemon atualizado"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Pokemon"
                    }
                  },
                  "xml": {
                    "name": "main"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/updatePokemonDTO"
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Deleta um Pokémon pelo ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do Pokémon a ser removido"
          }
        ],
        "responses": {
          "204": {
            "description": "Pokémon removido com sucesso"
          },
          "404": {
            "description": "Pokémon não encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              },
              "application/xml": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/pokemons/{id}/level": {
      "patch": {
        "tags": [
          "Pokemons"
        ],
        "summary": "Atualiza o nível de um Pokémon",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "default": {
            "description": ""
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/updatePokemonLevelDTO"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type1": {
            "type": "string",
            "example": "electric"
          },
          "type2": {
            "type": "string",
            "example": "flying"
          },
          "level": {
            "type": "number",
            "example": 10
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "special_attack": {
            "type": "number",
            "example": 50
          },
          "special_defense": {
            "type": "number",
            "example": 50
          },
          "speed": {
            "type": "number",
            "example": 90
          },
          "nickname": {
            "type": "string",
            "example": "bixin"
          }
        },
        "xml": {
          "name": "Pokemon"
        }
      },
      "createPokemonDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type1": {
            "type": "string",
            "example": "electric"
          },
          "type2": {
            "type": "string",
            "example": "flying"
          },
          "level": {
            "type": "number",
            "example": 10
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "special_attack": {
            "type": "number",
            "example": 50
          },
          "special_defense": {
            "type": "number",
            "example": 50
          },
          "speed": {
            "type": "number",
            "example": 90
          },
          "nickname": {
            "type": "string",
            "example": "bixin"
          }
        },
        "required": [
          "id",
          "name",
          "type1",
          "level",
          "hp",
          "attack",
          "defense",
          "special_attack",
          "special_defense",
          "speed"
        ],
        "xml": {
          "name": "createPokemonDTO"
        }
      },
      "updatePokemonDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Pikachu"
          },
          "type1": {
            "type": "string",
            "example": "electric"
          },
          "type2": {
            "type": "string",
            "example": "flying"
          },
          "level": {
            "type": "number",
            "example": 10
          },
          "hp": {
            "type": "number",
            "example": 35
          },
          "attack": {
            "type": "number",
            "example": 55
          },
          "defense": {
            "type": "number",
            "example": 40
          },
          "special_attack": {
            "type": "number",
            "example": 50
          },
          "special_defense": {
            "type": "number",
            "example": 50
          },
          "speed": {
            "type": "number",
            "example": 90
          },
          "nickname": {
            "type": "string",
            "example": "bixin"
          }
        },
        "xml": {
          "name": "updatePokemonDTO"
        }
      },
      "updatePokemonLevelDTO": {
        "type": "object",
        "properties": {
          "level": {
            "type": "number",
            "example": 50
          }
        },
        "required": [
          "level"
        ],
        "xml": {
          "name": "updatePokemonLevelDTO"
        }
      },
      "Trainer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "123e4567-e89b-12d3-a456-426614174000"
          },
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@exemplo.com"
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          },
          "createdAt": {
            "type": "string",
            "example": "2026-10-27T12:00:00.000Z"
          }
        },
        "xml": {
          "name": "Trainer"
        }
      },
      "createTrainerDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@exemplo.com"
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          }
        },
        "required": [
          "name",
          "email",
          "city"
        ],
        "xml": {
          "name": "createTrainerDTO"
        }
      },
      "updateTrainerDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Ash Ketchum"
          },
          "email": {
            "type": "string",
            "example": "ash@exemplo.com"
          },
          "city": {
            "type": "string",
            "example": "Pallet Town"
          }
        },
        "xml": {
          "name": "updateTrainerDTO"
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Mensagem de erro."
          }
        },
        "xml": {
          "name": "ErrorResponse"
        }
      }
    }
  }
}